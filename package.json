{
  "name": "browsepilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "BrowsePilot AI monorepo for the web app, Chrome extension, and shared agent package.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace @browsepilot/web run dev",
    "dev:extension": "npm --workspace @browsepilot/extension run dev",
    "build": "npm run build:shared && npm run build:web && npm run build:extension",
    "build:shared": "npm --workspace @browsepilot/shared run build",
    "build:web": "npm --workspace @browsepilot/web run build",
    "build:extension": "npm --workspace @browsepilot/extension run build",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "engines": {
    "node": ">=20"
  }
}
